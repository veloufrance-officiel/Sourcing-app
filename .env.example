# URL publique du site (utilisée pour les redirections OAuth / lien magique)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Dashboard > Settings > API Keys (nouveau format, remplace anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Server-only. Jamais préfixée NEXT_PUBLIC_, jamais envoyée au navigateur.
# Non utilisée dans ce scaffold (Phase 1) — réservée aux futurs jobs admin/webhooks.
SUPABASE_SECRET_KEY=sb_secret_xxxxx
