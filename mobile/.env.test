# Variables factices pour l'exécution des tests Jest — jamais de vraie
# valeur ici, les tests ne doivent jamais toucher la vraie base. Le
# garde-fou dans lib/supabase.ts (throw si absent) est correct pour
# l'app réelle, mais nécessite ces valeurs pour que les composants qui
# importent supabase puissent seulement être chargés en test, sans
# jamais réellement les utiliser.
EXPO_PUBLIC_SUPABASE_URL=https://test.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test
